    labels: valData.labels,
    datasets: [
      {label:'乐观', data:valData.optimistic, backgroundColor:'#e74c3c', borderRadius:3},
      {label:'中性', data:valData.neutral, backgroundColor:'#3498db', borderRadius:3},
      {label:'悲观', data:valData.pessimistic, backgroundColor:'#27ae60', borderRadius:3}
    ]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: { callbacks: { label: function(ctx){ return ctx.dataset.label + ': ' + ctx.parsed.y + '%'; } } }
    },
    scales: {
      y: {
        title: { display: true, text: '潜在空间 (%)' },
        ticks: { callback: function(v){ return v + '%'; } }
      },
      x: { ticks: { maxRotation: 45, minRotation: 30, font: { size: 10 } } }
    }
  }
});

new Chart(document.getElementById('radarChart'), {
  type: 'radar',
  data: {
    labels: ['确定性','弹性','护城河','估值吸引力'],
    datasets: [
      {label:'特高压设备', data:[8,6,9,6], backgroundColor:'rgba(52,152,219,0.15)', borderColor:'#3498db', pointBackgroundColor:'#3498db', borderWidth:1.5},
      {label:'设备出海', data:[6,9,5,5], backgroundColor:'rgba(231,76,60,0.15)', borderColor:'#e74c3c', pointBackgroundColor:'#e74c3c', borderWidth:1.5},
      {label:'二次设备', data:[9,5,8,6], backgroundColor:'rgba(39,174,96,0.15)', borderColor:'#27ae60', pointBackgroundColor:'#27ae60', borderWidth:1.5},
      {label:'核心零部件', data:[7,4,10,5], backgroundColor:'rgba(243,156,18,0.15)', borderColor:'#f39c12', pointBackgroundColor:'#f39c12', borderWidth:1.5}
    ]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { position: 'bottom', labels: { font: { size: 11 } } }
    },
    scales: {
      r: {
        beginAtZero: true,
        max: 10,
        ticks: { stepSize: 2, display: false },
        pointLabels: { font: { size: 12 } }
      }
    }
  }
});
</script>

</body>
</html>