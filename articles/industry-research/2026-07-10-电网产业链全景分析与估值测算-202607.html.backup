.valence-table td:nth-child(6),.valence-table td:nth-child(7),.valence-table td:nth-child(8),.valence-table td:nth-child(9),.valence-table td:nth-child(10){text-align:right;font-variant-numeric:tabular-nums}
.valence-table th:nth-child(6),.valence-table th:nth-child(7),.valence-table th:nth-child(8),.valence-table th:nth-child(9),.valence-table th:nth-child(10){text-align:right}
